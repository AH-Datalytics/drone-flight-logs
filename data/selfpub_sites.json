      "official_url": "https://services3.arcgis.com/8EQ1HhogM827boPC/arcgis/rest/services/Police_Drone_Flights/FeatureServer/0",
      "id_field": "OBJECTID",
      "fields": {
        "date": "Start_Date",
        "time": "Start_Time",
        "duration_hours": "Flight_Hours",
        "purpose": "Flight_Type",
        "location": "Location_Name",
        "case_number": "Call_For_Service",
        "extra": {
          "drone_model": "Drone_Model"
        },
        "purpose_labelled": {
          "field": "Notes",
          "label": "Reason"
        }
      },
      "note": "Also publishes to Skydio; the two cover different periods, its own log to March 2026 and Skydio after. Its service exposes Pilot_First_Name, Pilot_Last_Name, Pilot_Email, Takeoff_Latitude and Takeoff_Longitude, none of which are mapped. Its Notes field also names pilots in prose with no label to match on \u2014 \"Gallion at controls\" \u2014 so the prose is not published; only the labelled Reason is read out of it."
    },
